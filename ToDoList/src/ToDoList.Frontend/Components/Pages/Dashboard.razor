@using Microsoft.AspNetCore.Components.Web
@using ToDoList.Frontend.Models
@rendermode InteractiveServer

@inject ToDoList.Frontend.Clients.IToDoItemsClient toDoItemsClient

<PageTitle>Dashboard</PageTitle>

<div>
    <h2>TODOItems Dashboard</h2>
    <table class="table table-hover">
        <thead class="table-dark">
            <tr>
                <th><button @onclick="OrderById" class="btn btn-primary">ID</button></th>
                <th><button @onclick="OrderByName" class="btn btn-primary">Název</button></th>
                <th>Popis</th>
                <th>Dokončeno</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr class="table-light">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Dokončený" : "Nedokončený")</td>
                </tr>
            }
        </tbody>
    </table>
</div>


@code {
    private List<ToDoItemView> testData = new List<ToDoItemView> { new ToDoItemView(1, "Název", "Popis", false), new
ToDoItemView(2, "Název2", "Popis2", true),
new ToDoItemView(3, "Test název", "Popis3", false), new ToDoItemView(4, "Další název", "Popis4", true), new
ToDoItemView(5, "Poslední název", "Popis5", false) };

    private List<ToDoItemView> sortedData = new List<ToDoItemView>();


    private void OrderById()
    {
        sortedData = sortedData.OrderBy(item => item.Id).ToList();
    }

    private void OrderByName()
    {
        sortedData = sortedData.OrderBy(item => item.Name).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }
}
