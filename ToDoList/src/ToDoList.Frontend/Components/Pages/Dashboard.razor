@using Microsoft.AspNetCore.Components.Web
@using ToDoList.Frontend.Models
@rendermode InteractiveServer

@inject ToDoList.Frontend.Clients.IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager;

<PageTitle>Dashboard</PageTitle>

<div>
    <h2>TODOItems Dashboard</h2>
    <table class="table table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th><button @onclick="OrderById" class="btn btn-primary">Sort by ID</button></th>
                <th><button @onclick="OrderByName" class="btn btn-primary">Sort by Name</button></th>
                <th>Description</th>
                <th>Is Completed</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in sortedData)
            {
                <tr class="table-light">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.IsCompleted ? "Completed" : "Incomplete")</td>
                    <td>@(item.Category ?? "No Category")</td>
                    <td>
                        <button class="btn btn-success" @onclick="() => EditItem(item)">Edit</button>
                        <button class="btn btn-warning" @onclick="() => ToggleIsCompleted(item)">@(item.IsCompleted ?
                                                    "Mark as Incomplete" : "Mark as Completed")</button>
                        <button class="btn btn-danger" @onclick="() => DeleteItem(item)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


@code {
    private List<ToDoItemView> testData = new List<ToDoItemView> { new ToDoItemView(){ Id = 1, Name = "Název", Description =
"Popis", IsCompleted = false }, new
ToDoItemView(){ Id = 2, Name = "Název2", Description = "Popis2", IsCompleted = true },
new ToDoItemView(){ Id = 3, Name = "Test název", Description = "Popis3", IsCompleted = false }, new ToDoItemView(){ Id =
4, Name = "Další název", Description = "Popis4", IsCompleted = true }, new
ToDoItemView(){ Id = 5, Name = "Poslední název", Description = "Popis5", IsCompleted = false } };

    private List<ToDoItemView> sortedData = new List<ToDoItemView>();


    private void OrderById()
    {
        sortedData = sortedData.OrderBy(item => item.Id).ToList();
    }

    private void OrderByName()
    {
        sortedData = sortedData.OrderBy(item => item.Name).ToList();
    }

    private void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo($"editToDoItem/{toDoItem.Id}");
    }

    private async Task ToggleIsCompleted(ToDoItemView toDoItem)
    {
        toDoItem.IsCompleted = !toDoItem.IsCompleted;
        await toDoItemsClient.UpdateItemAsync(toDoItem);
    }

    private async Task DeleteItem(ToDoItemView toDoItem)
    {
        await toDoItemsClient.DeleteItemAsync(toDoItem.Id);
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        sortedData = await toDoItemsClient.ReadItemsAsync();
    }
}